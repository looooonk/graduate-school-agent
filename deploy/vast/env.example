# Optional convenience file for interactive shells.
# All non-secret Vast deployment values are loaded from config.yaml.
_vast_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_PATH="${CONFIG_PATH:-${_vast_env_dir}/../../config.yaml}"
. "${_vast_env_dir}/load-config-env.sh"
unset _vast_env_dir
