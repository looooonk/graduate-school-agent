# Optional convenience file for interactive shells.
# All non-secret deployment values are loaded from config.yaml.
_deploy_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_PATH="${CONFIG_PATH:-${_deploy_env_dir}/../config.yaml}"
. "${_deploy_env_dir}/load-config-env.sh"
unset _deploy_env_dir
